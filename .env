# APLICACIÓN

APP_NAME=PATO Data Discovery
APP_VERSION=3.0.0

# SCRAPY


SCRAPY_MAX_DEPTH=10
SCRAPY_CONCURRENT_REQUESTS=8
SCRAPY_DOWNLOAD_DELAY=0.5

SCRAPY_ROBOTSTXT_OBEY=true

SCRAPY_USER_AGENT=PATO-DataDiscovery/3.0 (academic research)


# ARCHIVOS


DOWNLOADS_DIR=downloads

FILE_EXTENSIONS=.pdf,.xlsx,.xls,.csv,.zip,.rar,.7z,.json,.xml,.txt,.doc,.docx


# DESCUBRIMIENTO


MIN_FILE_SCORE=50
MIN_LINK_SCORE=25

# API

API_HOST=127.0.0.1
API_PORT=8000
